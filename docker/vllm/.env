# Default docker/vllm env — HF hub id, not local fine-tune weights.
# Local 1.5B distill override lives at: .react/llm_local/docker.env

VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_TOKEN=
VLLM_HOST_PORT=8000
VLLM_TENSOR_PARALLEL=1
VLLM_PIPELINE_PARALLEL=1
VLLM_GPU_MEM_UTIL=0.90
VLLM_DTYPE=auto
VLLM_QUANTIZATION=
VLLM_MAX_MODEL_LEN=
VLLM_ENFORCE_EAGER=false
VLLM_ENABLE_LORA=false
VLLM_MAX_LORA_RANK=16
